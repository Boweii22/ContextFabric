# ContextFabric Gemma 4 local runtime
# Copy to .env.local only if you want to override defaults.

# Ollama local API endpoint
CONTEXTFABRIC_OLLAMA_URL=http://127.0.0.1:11434

# Low-memory model profile used by ContextFabric
CONTEXTFABRIC_OLLAMA_MODEL=cf-gemma4

# Source Gemma 4 model used to create cf-gemma4.
# Preferred for the challenge: gemma4:e2b. If Ollama cannot pull it yet,
# ContextFabric can still verify with the larger gemma4:e4b fallback.
CONTEXTFABRIC_GEMMA_SOURCE_MODEL=gemma4:e2b

# Embedding model for semantic search
CONTEXTFABRIC_EMBEDDING_MODEL=nomic-embed-text

# Lower these if your machine cannot allocate the model.
CONTEXTFABRIC_GEMMA_NUM_CTX=128
CONTEXTFABRIC_GEMMA_NUM_PREDICT=32
CONTEXTFABRIC_GEMMA_NUM_BATCH=4

# App defaults
CONTEXTFABRIC_API_PORT=47821
CONTEXTFABRIC_SYNC_PORT=47822
