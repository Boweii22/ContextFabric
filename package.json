{
  "name": "context-fabric",
  "version": "1.0.0",
  "description": "One Memory Across Every AI Tool - Your local AI memory operating system",
  "main": "./out/main/index.js",
  "homepage": "https://contextfabric.ai",
  "author": "ContextFabric",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "release:local": "node scripts/release-local.mjs",
    "e2e": "node scripts/e2e-check.mjs",
    "ui:e2e": "node scripts/ui-flow-check.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "extension:validate": "node scripts/package-extension.mjs --validate",
    "extension:package": "node scripts/package-extension.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@vlcn.io/crsqlite-allinone": "^0.15.2",
    "@xyflow/react": "^12.0.0",
    "axios": "^1.6.7",
    "better-sqlite3": "^9.4.3",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "electron-store": "^8.1.0",
    "express": "^4.18.2",
    "framer-motion": "^11.0.8",
    "glob": "^10.3.10",
    "lucide-react": "^0.359.0",
    "marked": "^12.0.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "tailwind-merge": "^2.2.1",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/typography": "^0.5.10",
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.20",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.2.57",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.4",
    "electron-builder": "^24.12.0",
    "electron-vite": "^2.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  },
  "build": {
    "appId": "ai.contextfabric.app",
    "productName": "ContextFabric",
    "icon": "resources/icon.ico",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
